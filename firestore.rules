rules_version = '2';

// Afzal Opportunities — Cloud Firestore security rules.
//
// Public users may READ published advertisements only.
// All writes are restricted to administrators, verified by the presence of a
// document at /admins/{uid} for the signed-in user. That document can only be
// created manually in the Firebase Console (see docs/firebase-setup.md).
//
// IMPORTANT: Hiding buttons in the admin UI is NOT the security boundary.
// These rules are the enforcement point; every write is rejected server-side
// unless the caller is an authenticated admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is signed in AND has an /admins/{uid} document.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /advertisements/{adId} {

      // Public read: published advertisements only.
      // Drafts and archived ads are invisible to the public app.
      allow get: if resource.data.status == 'published';

      // Public listing (the app's discovery feed): only published ads.
      // Drafts/archived never appear in list results for non-admins.
      allow list: if resource.data.status == 'published';

      // Admin reads (get/list) of everything: allowed so the admin panel can
      // manage drafts, archived, and expired advertisements.
      allow get, list: if isAdmin();

      // Admin writes only. Field-level validation runs on every create/update.
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.organization is string
        && request.resource.data.organization.size() > 0
        && request.resource.data.organization.size() <= 120
        && request.resource.data.category in ['jobs', 'scholarships', 'admissions', 'other']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['draft', 'published', 'archived']
        // Optional URL fields, when present, must be https URLs.
        // (Explicit nulls are allowed: the admin panel omits empty URLs on
        // create and deletes them on update, but null must not fail here.)
        && (!('sourceUrl' in request.resource.data)
            || request.resource.data.sourceUrl == null
            || request.resource.data.sourceUrl is string)
        && (!('applicationUrl' in request.resource.data)
            || request.resource.data.applicationUrl == null
            || request.resource.data.applicationUrl is string)
        // lastDate, when present, must be a "YYYY-MM-DD" string.
        && (!('lastDate' in request.resource.data)
            || request.resource.data.lastDate is string
            || request.resource.data.lastDate == null)
        // publishedAt may be a server timestamp on publish.
        && (!('isFeatured' in request.resource.data)
            || request.resource.data.isFeatured is bool);

      // Admin deletes (used when an ad is removed entirely; prefer "archived"
      // status over deletion so expired/advertisement history is preserved).
      allow delete: if isAdmin();
    }

    // Future-proof category metadata for the app's dynamic category chips.
    // Public read; admin-only write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin registry. Presence of /admins/{uid} is what grants admin rights.
    // - Each user may read only their own doc (used by the admin panel to
    //   confirm admin status after sign-in).
    // - Nobody may write through the client SDKs. The first admin doc is
    //   created manually in the Firebase Console; additional admins can only
    //   be created by an existing admin via the console (never client-side).
    // - list is denied for everyone: the admin roster is not enumerable.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // --- Private Teaching Jobs module ---------------------------------
    //
    // Admin authorization reuses the same trusted mechanism as the rest of
    // the app: presence of /admins/{uid} (see isAdmin() above). No client
    // can grant itself admin rights; the admins collection is not
    // client-writable.
    //
    // Approval flow: organizations, teachers and vacancies are created
    // with approvalStatus == 'pending'. Only the administrator can move a
    // record to 'approved' (or 'rejected'/'suspended'). Owners can never
    // escalate their own status: every owner write path below requires
    // the incoming approvalStatus to stay 'pending' (create) or unchanged
    // (update).

    // True when the caller owns the document being read/written.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    // True when a non-admin owner create carries no privilege escalation.
    function ownerCreateClean() {
      return request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.approvalStatus == 'pending';
    }

    // True when a non-admin owner update carries no privilege escalation.
    // Owners may leave approvalStatus untouched, or send a live (approved)
    // vacancy back to pending for re-approval after a material edit (see
    // TeachingService.updateVacancy). Every other status transition —
    // to approved, rejected or suspended, or from any non-approved status —
    // is admin-only.
    function ownerUpdateClean() {
      return request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          request.resource.data.approvalStatus == resource.data.approvalStatus
          || (
            resource.data.approvalStatus == 'approved'
            && request.resource.data.approvalStatus == 'pending'
          )
        );
    }

    match /teachingVacancies/{vacancyId} {
      // Public: approved vacancies only. Owners: their own submissions in
      // any status. Admins: everything.
      allow get: if isAdmin()
        || resource.data.approvalStatus == 'approved'
        || isOwner();
      allow list: if isAdmin()
        || resource.data.approvalStatus == 'approved'
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
      // Owners submit as pending; material edits to an approved vacancy
      // go through the client as pending again (see TeachingService).
      allow create: if isAdmin() || ownerCreateClean();
      allow update: if isAdmin() || ownerUpdateClean();
      // Owners may delete their own postings; admins may delete anything.
      allow delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
    }

    match /teachingOrganizations/{orgId} {
      // Private: owner + admin only. Contact details must never be public;
      // vacancy cards use the denormalized institution name instead.
      allow get: if isAdmin() || isOwner();
      allow list: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
      allow create: if isAdmin() || ownerCreateClean();
      allow update: if isAdmin() || ownerUpdateClean();
      allow delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
    }

    match /teacherProfiles/{profileId} {
      // Private by default: owner + admin only. A teacher's opt-in to
      // public visibility takes effect only after admin approval; there
      // is no public list of teacher profiles in v1.
      allow get: if isAdmin() || isOwner();
      allow list: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
      allow create: if isAdmin() || ownerCreateClean();
      allow update: if isAdmin() || ownerUpdateClean();
      allow delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
    }

    // Private per-vacancy contact details (phone/WhatsApp/email).
    //
    // The public teachingVacancies documents carry only the enable flags;
    // the actual contact details live here. Guests (not signed in) cannot
    // read them — Firebase enforces this, not just the app UI.
    // Read: owner, admin, or any signed-in user (teachers applying).
    // Write: owner (their own vacancies) or admin.
    match /teachingVacancyContacts/{vacancyId} {
      allow get: if isAdmin()
        || isOwner()
        || request.auth != null;
      allow list: if false;
      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid
            && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.ownerUid);
    }
  }
}
